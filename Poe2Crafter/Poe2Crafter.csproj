<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Poe2Crafter.Core\Poe2Crafter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.7.0</Version>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF native DLLs (PresentationNative, wpfgfx, D3DCompiler) must live INSIDE
         the single-file bundle — without this they're emitted next to the exe and
         a bare downloaded exe dies with DllNotFoundException on startup -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
