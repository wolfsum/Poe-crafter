<Window x:Class="Poe2Crafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Poe2Crafter.Converters"
        Title="PoE2 Crafter"
        Width="500" MinWidth="460" SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToCheckConverter      x:Key="BoolToCheck"/>
        <conv:BoolToStateBrushConverter x:Key="BoolToStateBrush"/>
        <DataTemplate x:Key="TierTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{StaticResource DimBrush}">T</TextBlock>
                <TextBlock Text="{Binding Tier}"/>
                <TextBlock Text="  "/>
                <TextBlock Text="{Binding Template}" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,2">
                <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,5,0"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding ModType[0]}" FontSize="9" FontWeight="Bold"
                               Foreground="#1e1e1e"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="★" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding Highlight, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TargetTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsExact}"
                          Content="exact" VerticalAlignment="Center" Margin="8,0,0,0"
                          Foreground="{StaticResource DimBrush}"/>
                <Button Grid.Column="2" Content="✕" Width="22" Height="22" Margin="6,0,0,0"
                        Foreground="{StaticResource DangerBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        Command="{Binding DataContext.RemoveTargetCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <StackPanel Margin="10">

        <!-- Header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Button Content="⇄" ToolTip="Switch game (restarts)"
                        Command="{Binding SwitchGameCommand}"
                        Margin="6,0,0,0" Padding="5,1" FontSize="11"/>
                <TextBlock Text="{Binding VersionText}" FontSize="10"
                           Foreground="{StaticResource DimBrush}"
                           VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                <Button Content="{Binding UpdateText}"
                        Command="{Binding UpdateCommand}"
                        Margin="8,0,0,0" Padding="6,2" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <CheckBox Content="Auto"  IsChecked="{Binding IsAutoMode}"
                          Foreground="{StaticResource DimBrush}"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Content="{Binding RunButtonText}"
                    Command="{Binding ToggleRunningCommand}"
                    Padding="10,4" FontSize="12"/>
        </Grid>

        <!-- Slot + Base -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding SlotOptions}"
                      SelectedItem="{Binding SelectedSlotOption}"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding BaseOptions}"
                      SelectedItem="{Binding SelectedBaseOption}"
                      Visibility="{Binding BaseVisibility}"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding JewelTypeOptions}"
                      SelectedItem="{Binding SelectedJewelType}"
                      Visibility="{Binding JewelTypeVisibility}"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding TabletTypeOptions}"
                      SelectedItem="{Binding SelectedTabletType}"
                      Visibility="{Binding TabletTypeVisibility}"/>
        </Grid>

        <!-- Influence (PoE1) — independent dimension, own row -->
        <ComboBox Margin="0,0,0,8"
                  ItemsSource="{Binding InfluenceOptions}"
                  SelectedItem="{Binding SelectedInfluence}"
                  Visibility="{Binding InfluenceVisibility}"/>

        <!-- Cluster jewel base (PoE1) -->
        <ComboBox Margin="0,0,0,8"
                  ItemsSource="{Binding ClusterBaseOptions}"
                  SelectedItem="{Binding SelectedClusterBase}"
                  Visibility="{Binding ClusterBaseVisibility}"/>

        <!-- Filter -->
        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,4"/>

        <!-- Mod groups -->
        <ListBox ItemsSource="{Binding FilteredGroups}"
                 SelectedItem="{Binding SelectedGroup}"
                 ItemTemplate="{StaticResource GroupTemplate}"
                 Height="230" Margin="0,0,0,8"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"/>

        <!-- Tier + Add -->
        <Grid Margin="0,0,0,10"
              Visibility="{Binding TierRowVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding TierOptions}"
                      SelectedItem="{Binding SelectedTier}"
                      ItemTemplate="{StaticResource TierTemplate}"/>

            <Button Grid.Column="2" Content="+ Add"
                    Command="{Binding AddTargetCommand}"/>
        </Grid>

        <!-- Auto-craft panel -->
        <StackPanel Visibility="{Binding AutoPanelVisibility}" Margin="0,0,0,8">
            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Auto-craft positions:" Foreground="{StaticResource DimBrush}"
                       FontSize="11" Margin="0,0,0,6"/>

            <!-- Currency slot -->
            <Button Command="{Binding SetCurrencyCommand}" Margin="0,0,0,8"
                    BorderBrush="{Binding CurrencySet, Converter={StaticResource BoolToStateBrush}}"
                    ToolTip="Позиция слота с валютой. Зелёная ✓ — задана, красный ✗ — нет.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrencySet, Converter={StaticResource BoolToCheck}}"
                               FontWeight="Bold"
                               Foreground="{Binding CurrencySet, Converter={StaticResource BoolToStateBrush}}"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Set Currency"/>
                </StackPanel>
            </Button>

            <!-- Item count -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Предметов в очереди:" VerticalAlignment="Center"
                           Foreground="{StaticResource DimBrush}" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="−" Command="{Binding DecItemsCommand}" Width="26" Padding="0"
                            ToolTip="Убрать предмет (мин. 1)"/>
                    <TextBlock Text="{Binding ItemCount}" Width="30" TextAlignment="Center"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="+" Command="{Binding IncItemsCommand}" Width="26" Padding="0"
                            ToolTip="Добавить предмет (макс. 10)"/>
                </StackPanel>
            </Grid>

            <!-- Item slots — one Set button per queued item -->
            <ItemsControl ItemsSource="{Binding ItemSlots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,6,6" MinWidth="88"
                                Command="{Binding DataContext.SetItemSlotCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                BorderBrush="{Binding IsSet, Converter={StaticResource BoolToStateBrush}}"
                                ToolTip="Позиция предмета. Зелёная ✓ — задана, красный ✗ — нет.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IsSet, Converter={StaticResource BoolToCheck}}"
                                           FontWeight="Bold"
                                           Foreground="{Binding IsSet, Converter={StaticResource BoolToStateBrush}}"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Label}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="● Click in game to set position" FontSize="10"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,0"
                       Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding AutoProgress}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Target list -->
        <StackPanel Visibility="{Binding TargetListVisibility}">
            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Target mods:" Foreground="{StaticResource DimBrush}"
                       FontSize="11" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding TargetMods}"
                          ItemTemplate="{StaticResource TargetTemplate}"/>
        </StackPanel>

        <!-- Status panel -->
        <Border Visibility="{Binding StatusVisibility}"
                Background="{Binding StatusBrush}"
                CornerRadius="3" Margin="0,10,0,0" Padding="10,8">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding MatchedLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White"
                                       FontSize="11" Opacity="0.9"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
