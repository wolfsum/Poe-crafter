<Window x:Class="Poe2Crafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE2 Crafter"
        Width="420" SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <DataTemplate x:Key="TierTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{StaticResource DimBrush}">T</TextBlock>
                <TextBlock Text="{Binding Tier}"/>
                <TextBlock Text="  "/>
                <TextBlock Text="{Binding Template}" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,2">
                <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,5,0"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding ModType[0]}" FontSize="9" FontWeight="Bold"
                               Foreground="#1e1e1e"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TargetTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsExact}"
                          Content="exact" VerticalAlignment="Center" Margin="8,0,0,0"
                          Foreground="{StaticResource DimBrush}"/>
                <Button Grid.Column="2" Content="✕" Width="22" Height="22" Margin="6,0,0,0"
                        Foreground="{StaticResource DangerBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        Command="{Binding DataContext.RemoveTargetCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <StackPanel Margin="10">

        <!-- Header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PoE2 Crafter" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="{Binding RunButtonText}"
                    Command="{Binding ToggleRunningCommand}"
                    Padding="10,4" FontSize="12"/>
        </Grid>

        <!-- Slot + Base -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding SlotOptions}"
                      SelectedItem="{Binding SelectedSlotOption}"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding BaseOptions}"
                      SelectedItem="{Binding SelectedBaseOption}"
                      Visibility="{Binding BaseVisibility}"/>
        </Grid>

        <!-- Filter -->
        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,4"/>

        <!-- Mod groups -->
        <ListBox ItemsSource="{Binding FilteredGroups}"
                 SelectedItem="{Binding SelectedGroup}"
                 ItemTemplate="{StaticResource GroupTemplate}"
                 Height="200" Margin="0,0,0,8"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"/>

        <!-- Tier + Add -->
        <Grid Margin="0,0,0,10"
              Visibility="{Binding TierRowVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding TierOptions}"
                      SelectedItem="{Binding SelectedTier}"
                      ItemTemplate="{StaticResource TierTemplate}"/>

            <Button Grid.Column="2" Content="+ Add"
                    Command="{Binding AddTargetCommand}"/>
        </Grid>

        <!-- Target list -->
        <StackPanel Visibility="{Binding TargetListVisibility}">
            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Target mods:" Foreground="{StaticResource DimBrush}"
                       FontSize="11" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding TargetMods}"
                          ItemTemplate="{StaticResource TargetTemplate}"/>
        </StackPanel>

        <!-- Status panel -->
        <Border Visibility="{Binding StatusVisibility}"
                Background="{Binding StatusBrush}"
                CornerRadius="3" Margin="0,10,0,0" Padding="10,8">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding MatchedLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White"
                                       FontSize="11" Opacity="0.9"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
